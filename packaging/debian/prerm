#!/bin/sh
# Ubuntu RDP Manager pre-removal. The helper is D-Bus activated; stop it so no running
# instance keeps using files that are about to be removed or replaced.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop urdm-helper.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
